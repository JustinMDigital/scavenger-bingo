{
  "name": "scavenger-bingo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "test": "npm run test:core && npm run test:ui",
    "test:core": "vitest run --config vitest.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "check:release-contact": "node scripts/verify-release-contact.mjs",
    "check": "npm run test && npm run build",
    "deploy": "npm run check && npm run check:release-contact && wrangler deploy",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@cloudflare/workers-types": "5.20260726.1",
    "@testing-library/react": "^16.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.12.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
