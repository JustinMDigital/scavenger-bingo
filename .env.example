# Monitored public address shown on the privacy and support pages.
VITE_SUPPORT_EMAIL=support@example.org

# Public OAuth web client ID used only when a host or authorized player explicitly
# creates a Google Slides presentation. Enable the Drive API, configure the OAuth
# consent screen, and add the exact local/live origins. This is not a client secret.
# Google loads on the export click; account selection is requested each time and
# the app does not cache the short-lived access token.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Both values are public browser configuration, not secrets. The release identity
# includes only their SHA-256 fingerprint so a configuration change cannot be
# mistaken for the same deployed artifact.
