{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scavenger-bingo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-19",
  "version_metadata": {
    "binding": "CF_VERSION"
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "ROOM_REGISTRY",
        "class_name": "RoomRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom", "RoomRegistry"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
